<odoo>

    <record id="appel_seance_view_form" model="ir.ui.view">
        <field name="name">appel.seance.view.form</field>
        <field name="model">appel.seance</field>
        <field name="arch" type="xml">
            <form string="Appel Séance">
                <header>
                    <button type="object" 
                        name="action_ongoing" 
                        string="Démarrer" 
                        class="btn-primary"
                        invisible="state != 'draft'"/>
                    <button type="object" 
                        name="action_done" 
                        string="Terminer" 
                        class="btn-primary"
                        invisible="state != 'ongoing'"/>
                    <button type="object" 
                        name="action_cancel" 
                        string="Annuler" 
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_ids" widget="many2many_tags" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="user_id" 
                                widget="many2one_avatar_user" 
                                readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="comments" string="Commentaire" invisible="state == 'draft'">
                            <field name="commentaire_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="partner_id" 
                                        domain="[('id', 'in', seance_partner_ids)]"/>
                                    <field name="timestamp" />
                                    <field name="commentaire" />
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Notes..." readonly="state == 'done'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="appel_seance_view_list" model="ir.ui.view">
        <field name="name">appel.seance.view.list</field>
        <field name="model">appel.seance</field>
        <field name="arch" type="xml">
            <list string="Appel Séance">
                <field name="name" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="date" optional="hide"/>
                <field name="partner_ids" optional="show" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="appel_seance_action">
        <field name="name">Appel Séance</field>
        <field name="path">seance</field>
        <field name="res_model">appel.seance</field>
        <field name="view_mode">list,form</field>
    </record>


    <record model="ir.actions.act_window" id="appel_seance_action_personne">
        <field name="name">Appel Séance</field>
        <field name="res_model">appel.seance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_ids', 'any', [('id', '=', active_id)])]</field>
    </record>
</odoo>
