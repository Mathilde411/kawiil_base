<odoo>

    <record id="appel_personne_view_form" model="ir.ui.view">
        <field name="name">appel.personne.view.form</field>
        <field name="model">appel.personne</field>
        <field name="arch" type="xml">
            <form string="Appel Personne">
                <header>
                    <button type="action" 
                        name="%(date_naissance_action)d" 
                        string="RaZ Anniversaire" 
                        class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_naissance"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="appel_personne_view_list" model="ir.ui.view">
        <field name="name">appel.personne.view.list</field>
        <field name="model">appel.personne</field>
        <field name="arch" type="xml">
            <list string="Appel Personne">
                <header>
                    <button type="action" 
                        name="%(date_naissance_action)d" 
                        string="RaZ Anniversaire" 
                        class="btn-primary"/>
                </header>
                <field name="name" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="date_naissance" optional="hide"/>
                <field name="age" optional="show"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="appel_personne_action">
        <field name="name">Appel Personne</field>
        <field name="path">personne</field>
        <field name="res_model">appel.personne</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
